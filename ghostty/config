# Ghostty — Fedora / GNOME Wayland
# Docs: ghostty +show-config --default --docs
# Reload live with ctrl+shift+,

# ── Chrome ───────────────────────────────────────────────────────────
# Kills the GTK headerbar (the "menu bar" with the hamburger + tabs).
# Move the window with Super+drag, resize from the edges.
# The menu also lives in the command palette: ctrl+shift+p.
window-decoration = none
window-theme = ghostty
maximize = true

# No margin — column 1 and row 1 sit flush against the window edge.
window-padding-x = 0
window-padding-y = 0
# The window is rarely an exact multiple of the cell size, so a few
# leftover pixels always remain. `false` parks them all at the right and
# bottom edges; `true` would split them and hand you back a thin left
# margin, which is the thing being removed here.
window-padding-balance = false

# No "resized to 80x24" overlay, no "copied to clipboard" toast.
resize-overlay = never
app-notifications = no-clipboard-copy

# ── Aesthetics ───────────────────────────────────────────────────────
# Gruvbox, matching the tmux status bar and the Neovim colourscheme.
# All three layers share one palette: cream foreground #ebdbb2 over a
# black ground, with the warm accents — harvest gold #fabd2f, burnt
# orange #fe8019, olive #b8bb26 — doing the work.
#
# "Dark Hard" rather than plain "Dark": with the background forced to
# black below, the only thing this choice still decides is how dark the
# theme's own surfaces are, and Hard's are the closest to the black they
# sit on.
theme = Gruvbox Dark Hard

# Adwaita's own dark window background, so the terminal is the same shade
# as every other app on the desktop instead of a darker rectangle among
# them. Read straight out of libadwaita rather than copied from a blog
# post — check it after a GNOME upgrade with:
#
#   python3 -c "import gi;gi.require_version('Gtk','4.0');gi.require_version('Adw','1');\
# from gi.repository import Gtk,Adw;Adw.init();\
# sm=Adw.StyleManager.get_default();sm.set_color_scheme(Adw.ColorScheme.FORCE_DARK);\
# print(Gtk.Window().get_style_context().lookup_color('window_bg_color')[1].to_string())"
#
# This must stay *after* the `theme` line: Ghostty loads the theme first
# and then lets the rest of the file win, so moving it above would
# silently do nothing.
#
# One honest caveat: Adwaita's darks are very slightly cool (#222226 has
# more blue than red) while Gruvbox is warm throughout. At this lightness
# the cast is nearly invisible, but it is the reason this will never be
# quite as seamless as a Gruvbox grey would be — it is trading palette
# purity for matching the desktop, deliberately.
#
# The palette itself is untouched, so ANSI 0 stays #1d2021 and the tmux
# status bar's dark segments still read as a surface sitting on top of
# the terminal rather than dissolving into it.
background = #222226

# Fully opaque. To bring transparency back, set a value below 1 —
# note that GNOME/Wayland has no blur protocol, so `background-blur`
# would stay a no-op here regardless.
background-opacity = 1

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# ── Scroll speed ─────────────────────────────────────────────────────
# Target: one wheel detent on the MX Master 3S = one line.
#
# Three layers stack, so the other two are pinned to 1 and this is the
# only live knob:
#   tmux  -N 1        (~/.config/tmux/tmux.conf, copy-mode wheel)
#   nvim  mousescroll=ver:1
#
# The 3S's high-resolution wheel emits roughly 1.7 events per physical
# detent rather than a clean 1, so the multiplier scales that back to
# ~1.0 rather than being 1 itself. No prefix = applies to both the
# precision and discrete paths, since GTK on Wayland can report a hi-res
# wheel either way and this sidesteps having to know which.
#
# Too fast? Lower toward 0.4. Too slow, or detents that do nothing at
# all (the multiplier floored a sub-step to zero)? Raise toward 1.0 and
# take the extra line. Leave the tmux and nvim numbers at 1.
mouse-scroll-multiplier = 0.6

# ── Typography ───────────────────────────────────────────────────────
# "Mono" variant = strict single-width cells, which keeps the tmux
# status bar and box-drawing characters aligned.
font-family = JetBrainsMono Nerd Font Mono
font-size = 13
adjust-cell-height = 12%

# ── Keybindings ──────────────────────────────────────────────────────
# There are none. Every shortcut is Ghostty's own default, so the docs
# at ghostty.org and the command palette both tell the truth.
#
# To see the full list:  ghostty +list-keybinds
# Or in the terminal:    ctrl+shift+p   (command palette, searchable)

# ── Behaviour ────────────────────────────────────────────────────────
# Safe to skip the close prompt: tmux keeps the session alive anyway.
confirm-close-surface = false
scrollback-limit = 10000000
